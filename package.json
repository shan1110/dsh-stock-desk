{
  "name": "dsh-stock-desk",
  "version": "0.1.3",
  "description": "A 股行情工作台：整页看盘、常驻药丸，并给 agent 提供真实行情取数工具。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "stock",
    "a-share",
    "行情",
    "股票",
    "看盘"
  ],
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "lib",
    "locale",
    "data/universe.json"
  ],
  "author": "cai shan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shan1110/dsh-stock-desk.git"
  },
  "homepage": "https://github.com/shan1110/dsh-stock-desk#readme",
  "bugs": {
    "url": "https://github.com/shan1110/dsh-stock-desk/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    },
    "manifestVersion": 1
  }
}
